{
  "name": "deepwork",
  "version": "0.2.2",
  "description": "A local-first personal desktop AI agent with MCP plugins and GUI fallback.",
  "main": "./out/main/index.js",
  "author": "DeepWork contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@nut-tree-fork/libnut": "^4.2.6",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "deepagents": "^1.12.1",
    "electron-updater": "^6.3.9",
    "i18next": "^26.3.6",
    "langchain": "^1.5.4",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "p-queue": "9.1.0",
    "p-retry": "7.1.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.deepwork.app",
    "productName": "DeepWork",
    "afterPack": "./scripts/verify-packaged-runtime.mjs",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@nut-tree-fork/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@nut-tree-fork/libnut",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "better-sqlite3": "^12.10.0"
    },
    "patchedDependencies": {
      "@langchain/langgraph-sdk@1.9.28": "patches/@langchain__langgraph-sdk@1.9.28.patch"
    }
  }
}
