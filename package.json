{
  "name": "deepwork",
  "version": "0.0.1",
  "description": "A local-first personal desktop AI agent with MCP plugins and GUI fallback.",
  "main": "./out/main/index.js",
  "author": "DeepWork contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@nut-tree-fork/libnut": "^4.2.6",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "better-sqlite3": "^13.0.2",
    "deepagents": "^1.12.1",
    "langchain": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "ai.deepwork.app",
    "productName": "DeepWork",
    "files": ["out/**/*", "package.json"],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/@nut-tree-fork/**/*"
    ],
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@nut-tree-fork/libnut",
      "electron",
      "esbuild"
    ]
  }
}

